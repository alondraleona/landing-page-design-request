---
import { sanityClient } from 'sanity:client'
import { urlFor } from '@/sanity/lib/urlFor'

interface Post {
  title: string
  slug: string
  excerpt?: string
  coverImage?: any
  publishedAt: string
}

const posts: Post[] = await sanityClient.fetch(`
  *[_type == "post"] | order(publishedAt desc) [0...3] {
    title,
    "slug": slug.current,
    excerpt,
    coverImage,
    publishedAt
  }
`)

const dateFormatter = new Intl.DateTimeFormat('es-PE', { day: 'numeric', month: 'long', year: 'numeric' })
---

{posts.length > 0 && (
  <section id="blog" class="py-28 px-6 relative">
    <div class="max-w-6xl mx-auto">
      <div data-reveal class="opacity-0 translate-y-6 mb-16 flex flex-col md:flex-row md:items-end md:justify-between gap-6">
        <div>
          <span class="text-xs font-semibold tracking-widest uppercase mb-4 block" style={{ color: '#E5A93C', fontFamily: 'Inter, sans-serif' }}>
            — Blog
          </span>
          <h2 class="heading font-extrabold leading-tight" style={{ fontSize: 'clamp(2rem, 4vw, 3rem)', letterSpacing: '-0.02em' }}>
            Ideas sobre diseño<br />
            <span style={{ color: '#2563EB' }}>y desarrollo web</span>
          </h2>
        </div>
        <a
          href="/blog"
          class="text-sm font-bold px-6 py-3 rounded-xl transition-all duration-200 hover:scale-105 glass whitespace-nowrap"
          style={{ fontFamily: 'Plus Jakarta Sans, sans-serif' }}
        >
          Ver todos los artículos →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {posts.map((post) => (
          <a
            href={`/blog/${post.slug}`}
            data-reveal
            class="opacity-0 translate-y-6 group rounded-2xl overflow-hidden flex flex-col"
            style={{ border: '1px solid rgba(255,255,255,0.07)', background: 'rgba(255,255,255,0.04)' }}
          >
            {post.coverImage && (
              <div class="h-44 overflow-hidden">
                <img
                  src={urlFor(post.coverImage).width(400).height(260).fit('crop').auto('format').url()}
                  alt={post.title}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                  loading="lazy"
                />
              </div>
            )}
            <div class="p-5 flex-1 flex flex-col">
              <div class="text-white/40 text-xs mb-2" style={{ fontFamily: 'Inter, sans-serif' }}>
                {dateFormatter.format(new Date(post.publishedAt))}
              </div>
              <h3 class="heading font-bold text-white mb-2 transition-colors duration-200 group-hover:text-[#7BAAF7]" style={{ fontSize: '1.05rem', letterSpacing: '-0.01em' }}>
                {post.title}
              </h3>
              {post.excerpt && (
                <p class="text-white/55 text-sm leading-relaxed" style={{ fontFamily: 'Inter, sans-serif' }}>
                  {post.excerpt}
                </p>
              )}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<script>
  import { gsap, ScrollTrigger, prefersReducedMotion } from '@/lib/gsap'

  const section = document.querySelector('#blog')
  if (section) {
    const revealEls = section.querySelectorAll<HTMLElement>('[data-reveal]')

    if (prefersReducedMotion()) {
      gsap.set(revealEls, { opacity: 1, y: 0 })
    } else {
      gsap.to(revealEls, {
        opacity: 1,
        y: 0,
        duration: 0.6,
        ease: 'power3.out',
        stagger: 0.1,
        clearProps: 'transform',
        scrollTrigger: { trigger: section, start: 'top 80%', once: true },
      })

      window.addEventListener('load', () => ScrollTrigger.refresh())
    }
  }
</script>
