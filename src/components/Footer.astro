---
import AloLogo from './AloLogo.astro'

const socials = ['Instagram', 'LinkedIn', 'Behance']
---

<footer class="py-10 px-6" style={{ borderTop: '1px solid rgba(255,255,255,0.07)' }}>
  <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
    <AloLogo size="sm" />
    <p class="text-white/25 text-xs text-center" style={{ fontFamily: 'Inter, sans-serif' }}>
      © 2025 aló Studio · Lima, Perú · Todos los derechos reservados
    </p>
    <div class="flex gap-5">
      {socials.map((s) => (
        <a href="#" class="text-white/30 hover:text-white text-xs transition-colors" style={{ fontFamily: 'Inter, sans-serif' }}>
          {s}
        </a>
      ))}
    </div>
  </div>
</footer>
