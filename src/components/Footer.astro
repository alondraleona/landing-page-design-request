---
import AloLogo from './AloLogo.astro'

const socials = [
  { label: 'Instagram', href: 'https://www.instagram.com/alostudio.pe/' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/cynthiaalondraleonabal/' },
  { label: 'Behance', href: 'https://www.behance.net/cynthiaalondraLA' },
]
---

<footer class="py-10 px-6" style={{ borderTop: '1px solid rgba(255,255,255,0.07)' }}>
  <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
    <AloLogo size="sm" />
    <p class="text-white/50 text-xs text-center" style={{ fontFamily: 'Inter, sans-serif' }}>
      © 2025 aló Studio · Lima, Perú · Todos los derechos reservados
    </p>
    <div class="flex items-center gap-5">
      <a href="/servicios#proceso" class="text-white/50 hover:text-white text-xs transition-colors" style={{ fontFamily: 'Inter, sans-serif' }}>
        Proceso
      </a>
      <a href="/politicas" class="text-white/50 hover:text-white text-xs transition-colors" style={{ fontFamily: 'Inter, sans-serif' }}>
        Políticas
      </a>
      <button
        id="cookie-prefs-link"
        type="button"
        class="text-white/50 hover:text-white text-xs transition-colors"
        style={{ fontFamily: 'Inter, sans-serif' }}
      >
        Cookies
      </button>
      {socials.map((s) => (
        <a href={s.href} target="_blank" rel="noopener noreferrer" class="text-white/50 hover:text-white text-xs transition-colors" style={{ fontFamily: 'Inter, sans-serif' }}>
          {s.label}
        </a>
      ))}
    </div>
  </div>
</footer>

<script>
  document.getElementById('cookie-prefs-link')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('cookie-consent:open'))
  })
</script>
