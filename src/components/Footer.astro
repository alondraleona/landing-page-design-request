---
import AloLogo from './AloLogo.astro'

const socials = [
  {
    label: 'Instagram',
    href: 'https://www.instagram.com/alostudio.pe/',
    icon: '<path d="M12 2c2.72 0 3.06.01 4.12.06 1.06.05 1.79.22 2.43.47.66.26 1.22.6 1.77 1.15.55.55.9 1.11 1.15 1.77.25.64.42 1.37.47 2.43.05 1.06.06 1.4.06 4.12s-.01 3.06-.06 4.12c-.05 1.06-.22 1.79-.47 2.43-.26.66-.6 1.22-1.15 1.77-.55.55-1.11.9-1.77 1.15-.64.25-1.37.42-2.43.47-1.06.05-1.4.06-4.12.06s-3.06-.01-4.12-.06c-1.06-.05-1.79-.22-2.43-.47-.66-.26-1.22-.6-1.77-1.15-.55-.55-.9-1.11-1.15-1.77-.25-.64-.42-1.37-.47-2.43C2.01 15.06 2 14.72 2 12s.01-3.06.06-4.12c.05-1.06.22-1.79.47-2.43.26-.66.6-1.22 1.15-1.77.55-.55 1.11-.9 1.77-1.15.64-.25 1.37-.42 2.43-.47C8.94 2.01 9.28 2 12 2Zm0 5a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0 8.2a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4Zm5.4-8.4a1.2 1.2 0 1 1-2.4 0 1.2 1.2 0 0 1 2.4 0Z" fill="currentColor"/>',
  },
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/cynthiaalondraleonabal/',
    icon: '<path d="M6.94 8.5H3.56V20.5H6.94V8.5ZM5.25 3.5C4.1 3.5 3.25 4.36 3.25 5.44 3.25 6.5 4.08 7.38 5.23 7.38H5.25c1.17 0 1.98-.88 1.98-1.94C7.23 4.36 6.42 3.5 5.25 3.5ZM20.5 13.63c0-3.32-1.78-4.86-4.15-4.86-1.91 0-2.76 1.05-3.24 1.79V8.5H9.73c.04.94 0 12 0 12h3.38v-6.7c0-.36.03-.72.13-.97.29-.72.95-1.47 2.06-1.47 1.45 0 2.03 1.1 2.03 2.72V20.5h3.38l-.01-6.87Z" fill="currentColor"/>',
  },
  {
    label: 'Behance',
    href: 'https://www.behance.net/cynthiaalondraLA',
    icon: '<path d="M9.8 12.4c.9-.45 1.4-1.2 1.4-2.3 0-2.1-1.55-2.9-3.5-2.9H2v11.6h5.9c2.1 0 4-1 4-3.3 0-1.4-.7-2.5-2.1-3.1ZM4.6 9.1h2.5c.9 0 1.7.3 1.7 1.3 0 .9-.6 1.35-1.6 1.35H4.6V9.1Zm2.85 7.7H4.6v-3H7.5c1.1 0 1.85.5 1.85 1.5 0 1.1-.85 1.5-1.9 1.5ZM21.9 10.2h-5.4v1h5.4v-1ZM17.9 12.6c-2.5 0-4.1 1.8-4.1 4.2 0 2.5 1.5 4.2 4.15 4.2 2 0 3.3-.9 3.85-2.6h-1.95c-.2.55-.85.95-1.85.95-1.3 0-2.05-.75-2.15-1.9h6.1c.05-2.9-1.15-4.85-4.05-4.85Zm-2.05 3.15c.15-1.05.85-1.65 1.95-1.65 1.05 0 1.75.65 1.85 1.65h-3.8Z" fill="currentColor"/>',
  },
]
---

<footer class="py-10 px-6" style={{ borderTop: '1px solid rgba(255,255,255,0.07)' }}>
  <div class="max-w-6xl mx-auto flex flex-col gap-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <AloLogo size="sm" />

      <div class="flex items-center gap-3">
        {socials.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={s.label}
            title={s.label}
            class="social-icon flex items-center justify-center rounded-full transition-all duration-200"
            style={{ width: '40px', height: '40px', background: 'rgba(255,255,255,0.05)', border: '1px solid rgba(255,255,255,0.12)' }}
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" set:html={s.icon} />
          </a>
        ))}
      </div>
    </div>

    <div class="flex flex-col md:flex-row items-center justify-between gap-4 pt-6" style={{ borderTop: '1px solid rgba(255,255,255,0.06)' }}>
      <p class="text-white/50 text-xs text-center" style={{ fontFamily: 'Inter, sans-serif' }}>
        © 2025 aló Studio · Lima, Perú · Todos los derechos reservados
      </p>
      <div class="flex items-center gap-5">
        <a href="/servicios#proceso" class="text-white/50 hover:text-white text-xs transition-colors" style={{ fontFamily: 'Inter, sans-serif' }}>
          Proceso
        </a>
        <a href="/politicas" class="text-white/50 hover:text-white text-xs transition-colors" style={{ fontFamily: 'Inter, sans-serif' }}>
          Políticas
        </a>
        <button
          id="cookie-prefs-link"
          type="button"
          class="text-white/50 hover:text-white text-xs transition-colors"
          style={{ fontFamily: 'Inter, sans-serif' }}
        >
          Cookies
        </button>
      </div>
    </div>
  </div>
</footer>

<style>
  .social-icon {
    color: rgba(255, 255, 255, 0.6);
  }
  .social-icon:hover {
    color: #0f131c;
    background: #e5a93c;
    border-color: #e5a93c;
    box-shadow: 0 0 20px rgba(229, 169, 60, 0.4);
    transform: translateY(-2px);
  }
</style>

<script>
  document.getElementById('cookie-prefs-link')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('cookie-consent:open'))
  })
</script>
