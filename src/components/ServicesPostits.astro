---
import { services } from '@/data/services'

const rotations = [-4, 3, -3, 4, -2]
---

<section id="servicios" class="py-28 px-6 relative">
  <div class="max-w-6xl mx-auto">
    <div data-reveal class="opacity-0 translate-y-6 mb-20">
      <span class="text-xs font-semibold tracking-widest uppercase mb-4 block" style={{ color: '#E5A93C', fontFamily: 'Inter, sans-serif' }}>
        — Nuestros Servicios
      </span>
      <h2 class="heading font-extrabold leading-tight mb-4" style={{ fontSize: 'clamp(2rem, 4vw, 3.2rem)', letterSpacing: '-0.02em' }}>
        Todo lo que necesitas para<br />
        <span style={{ color: '#2563EB' }}>escalar en digital</span>
      </h2>
      <p class="text-white/50 max-w-lg" style={{ fontFamily: 'Inter, sans-serif', fontSize: '1.05rem' }}>
        Cinco áreas de especialización, una sola visión: hacer crecer tu negocio de forma sostenida y medible.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-16">
      {services.map((s, i) => (
        <div
          data-postit
          data-rotation={rotations[i % rotations.length]}
          class="opacity-0 relative p-6 pt-9"
          style={{
            background: s.accent,
            color: '#0F131C',
            borderRadius: '2px',
            boxShadow: '0 16px 30px rgba(0,0,0,0.35)',
            transform: `rotate(${rotations[i % rotations.length]}deg)`,
          }}
        >
          {/* Tape */}
          <span
            class="absolute -top-3 left-1/2 -translate-x-1/2 block"
            style={{
              width: '64px',
              height: '22px',
              background: 'rgba(255,255,255,0.55)',
              boxShadow: '0 2px 6px rgba(0,0,0,0.15)',
              transform: 'rotate(-2deg)',
            }}
          />

          <div class="mb-4 text-2xl">{s.icon}</div>
          <h3 class="heading font-bold text-lg mb-1">{s.title}</h3>
          <p class="text-xs font-semibold mb-4 uppercase tracking-wider opacity-70" style={{ fontFamily: 'Inter, sans-serif' }}>{s.tagline}</p>
          <p class="text-sm leading-relaxed mb-5 opacity-80" style={{ fontFamily: 'Inter, sans-serif' }}>{s.desc}</p>

          <ul class="space-y-1.5">
            {s.features.map((f) => (
              <li class="flex items-center gap-2 text-xs font-medium opacity-80" style={{ fontFamily: 'Inter, sans-serif' }}>
                <span class="w-1 h-1 rounded-full flex-shrink-0" style={{ background: '#0F131C' }} />
                {f}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div data-reveal class="opacity-0 translate-y-6 mt-16">
      <a
        href="/servicios"
        class="inline-flex items-center gap-2 text-sm font-bold px-6 py-3 rounded-xl transition-all duration-200 hover:scale-105 glass"
        style={{ fontFamily: 'Plus Jakarta Sans, sans-serif' }}
      >
        Ver todos los servicios →
      </a>
    </div>
  </div>
</section>

<script>
  // Deferred: this section is below the fold, so GSAP (46 KiB) doesn't need
  // to compete with the initial page load's critical resources.
  const init = async () => {
    const { gsap, ScrollTrigger, prefersReducedMotion } = await import('@/lib/gsap')

    const section = document.querySelector('#servicios')
    if (section) {
      const revealEls = section.querySelectorAll<HTMLElement>('[data-reveal]')
      const postits = section.querySelectorAll<HTMLElement>('[data-postit]')

      if (prefersReducedMotion()) {
        gsap.set(revealEls, { opacity: 1, y: 0 })
        postits.forEach((el) => {
          const rotation = Number(el.dataset.rotation ?? '0')
          gsap.set(el, { opacity: 1, rotation })
        })
      } else {
        gsap.to(revealEls, {
          opacity: 1,
          y: 0,
          duration: 0.6,
          ease: 'power3.out',
          stagger: 0.1,
          clearProps: 'transform',
          scrollTrigger: { trigger: section, start: 'top 80%', once: true },
        })

        postits.forEach((el, i) => {
          const rotation = Number(el.dataset.rotation ?? '0')
          gsap.fromTo(
            el,
            { opacity: 0, y: 40, scale: 0.85, rotation: rotation * 2.5 },
            {
              opacity: 1,
              y: 0,
              scale: 1,
              rotation,
              duration: 0.65,
              ease: 'back.out(1.6)',
              delay: i * 0.1,
              scrollTrigger: { trigger: el, start: 'top 88%', once: true },
            },
          )

          el.addEventListener('mouseenter', () => {
            gsap.to(el, { rotation: 0, scale: 1.04, duration: 0.3, ease: 'power2.out' })
          })
          el.addEventListener('mouseleave', () => {
            gsap.to(el, { rotation, scale: 1, duration: 0.3, ease: 'power2.out' })
          })
        })

        window.addEventListener('load', () => ScrollTrigger.refresh())
      }
    }
  }

  if ('requestIdleCallback' in window) {
    requestIdleCallback(init)
  } else {
    setTimeout(init, 200)
  }
</script>
