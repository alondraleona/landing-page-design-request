---
interface Props {
  href?: string
  ariaLabel?: string
  words?: string[]
}

const {
  href = '/eventos',
  ariaLabel = 'Ver eventos, capacitaciones y cursos de Alo Studio',
  words = ['Eventos', 'Capacitaciones', 'Cursos'],
} = Astro.props

// Repeated so the track has enough width to loop seamlessly on wide screens.
const line = Array.from({ length: 8 }, () => words).flat()
---

<section class="relative overflow-hidden py-10 sm:py-14">
  <a href={href} aria-label={ariaLabel} class="ticker-link block">
    <div class="ticker-rotate" style={{ background: '#1a2030' }}>
      <div class="ticker-track flex items-center whitespace-nowrap py-3 sm:py-4">
        {[0, 1].map(() => (
          <div class="flex items-center flex-shrink-0">
            {line.map((word) => (
              <span class="ticker-word inline-block mx-10 sm:mx-16">{word}</span>
            ))}
          </div>
        ))}
      </div>
    </div>
  </a>
</section>

<style>
  .ticker-rotate {
    width: 102%;
    margin-left: -1%;
    transform: rotate(-4deg);
  }
  .ticker-word {
    font-family: 'Inter', sans-serif;
    font-weight: 400;
    font-size: clamp(1.1rem, 2.2vw, 1.6rem);
    background-image: linear-gradient(90deg, #2563EB 0%, #E5A93C 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .ticker-track {
    width: max-content;
    animation: ticker-scroll 32s linear infinite;
  }
  .ticker-link:hover .ticker-track,
  .ticker-link:focus-visible .ticker-track {
    animation-play-state: paused;
  }
  @keyframes ticker-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ticker-track {
      animation: none;
    }
  }
</style>
