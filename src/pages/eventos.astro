---
import Layout from '../layouts/Layout.astro'
import EventsList from '../components/EventsList.astro'
import EventsTicker from '../components/EventsTicker.astro'
import { sanityClient } from 'sanity:client'
import { resolveEvent } from '../sanity/lib/events'

const today = new Date().toISOString().slice(0, 10)
const rawEvents = await sanityClient.fetch(`*[_type == "event" && date >= $today] | order(date asc)`, { today })
const events = rawEvents.map(resolveEvent)
---

<Layout
  title="Eventos, Capacitaciones y Cursos | Alo Studio"
  description="Talleres, capacitaciones y cursos de diseño, desarrollo web y automatización con IA. Descubre las próximas ediciones y reserva tu cupo."
  path="/eventos"
>
  <div class="pt-28 sm:pt-32">
    <EventsTicker href="#contacto" ariaLabel="Reserva tu cupo en los próximos eventos" />
  </div>
  <EventsList events={events} />
</Layout>
