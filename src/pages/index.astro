---
import Layout from '../layouts/Layout.astro'
import Hero from '../components/Hero.astro'
import AboutAlo from '../components/AboutAlo.astro'
import ImpactSection from '../components/ImpactSection.astro'
import ProjectsCarousel from '../components/ProjectsCarousel'
import VideoReelsMarquee from '../components/VideoReelsMarquee.astro'
import ServicesPostits from '../components/ServicesPostits.astro'
import BlogPreview from '../components/BlogPreview.astro'
import EventsList from '../components/EventsList.astro'
import EventsTicker from '../components/EventsTicker.astro'
import { sanityClient } from 'sanity:client'
import { resolveProject } from '../sanity/lib/projects'
import { resolveVideoReel } from '../sanity/lib/videoReels'
import { resolveEvent } from '../sanity/lib/events'

// The evento-alostudio Vercel project builds this same repo but serves the
// events page as its root (eventos.alostudio.pe), so a plain rewrite can't
// win over the static index.html this route also produces for the main site.
const isEventsHome = import.meta.env.PUBLIC_EVENTS_HOME === 'true'

let projects: ReturnType<typeof resolveProject>[] = []
let reels: ReturnType<typeof resolveVideoReel>[] = []
let events: ReturnType<typeof resolveEvent>[] = []

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://alostudio.pe'

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Alo Studio',
  url: siteUrl,
  logo: new URL('/favicon/webclip-512x512.png', Astro.site).toString(),
  sameAs: [
    'https://www.instagram.com/alostudio.pe/',
    'https://www.linkedin.com/in/cynthiaalondraleonabal/',
    'https://www.behance.net/cynthiaalondraLA',
  ],
}

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Alo Studio',
  url: siteUrl,
  inLanguage: 'es-PE',
  hasPart: {
    '@type': 'SiteNavigationElement',
    name: ['Inicio', 'Servicios', 'Portafolio', 'Blog', 'Eventos'],
    url: [
      `${siteUrl}/`,
      `${siteUrl}/servicios`,
      `${siteUrl}/portafolio`,
      `${siteUrl}/blog`,
      'https://eventos.alostudio.pe',
    ],
  },
}

if (isEventsHome) {
  const today = new Date().toISOString().slice(0, 10)
  const rawEvents = await sanityClient.fetch(`*[_type == "event" && date >= $today] | order(date asc)`, { today })
  events = rawEvents.map(resolveEvent)
} else {
  const rawProjects = await sanityClient.fetch(`*[_type == "project"] | order(order asc)`)
  projects = rawProjects.map(resolveProject)

  const rawReels = await sanityClient.fetch(`*[_type == "videoReel"] | order(order asc) { title, "videoUrl": video.asset->url, poster }`)
  reels = rawReels.map(resolveVideoReel)
}
---

{isEventsHome ? (
  <Layout
    title="Eventos, Capacitaciones y Cursos | Alo Studio"
    description="Talleres, capacitaciones y cursos de diseño, desarrollo web y automatización con IA. Descubre las próximas ediciones y reserva tu cupo."
    path="/"
  >
    <div class="pt-24 sm:pt-28">
      <EventsTicker href="#contacto" ariaLabel="Reserva tu cupo en los próximos eventos" />
    </div>
    <EventsList events={events} />
  </Layout>
) : (
  <Layout
    title="Alo Studio | Diseño y Desarrollo Web"
    description="Agencia digital en Lima, Perú. Diseñamos y desarrollamos sitios web, tiendas online y automatizaciones que convierten. +20 proyectos entregados, 98% de satisfacción."
    path="/"
    jsonLd={[organizationJsonLd, websiteJsonLd]}
  >
    <Hero />
    <AboutAlo />
    <ImpactSection />
    <ProjectsCarousel client:visible projects={projects} />
    <VideoReelsMarquee reels={reels} />
    <ServicesPostits />
    <BlogPreview />
  </Layout>
)}
