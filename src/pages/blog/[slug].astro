---
import Layout from '../../layouts/Layout.astro'
import { PortableText } from 'astro-portabletext'
import { sanityClient } from 'sanity:client'
import { urlFor } from '../../sanity/lib/urlFor'
import { resolveVideoEmbed } from '../../sanity/lib/videoEmbed'
import PortableTextImage from '../../components/PortableTextImage.astro'

export async function getStaticPaths() {
  const slugs: string[] = await sanityClient.fetch(`*[_type == "post" && defined(slug.current)].slug.current`)
  return slugs.map((slug) => ({ params: { slug } }))
}

const { slug } = Astro.params

const post = await sanityClient.fetch(
  `*[_type == "post" && slug.current == $slug][0]{
    title, excerpt, coverImage, body, publishedAt, tags, videoUrl,
    audioFile{asset->{url}}
  }`,
  { slug },
)

if (!post) {
  return Astro.redirect('/blog', 302)
}

const dateFormatter = new Intl.DateTimeFormat('es-PE', { day: 'numeric', month: 'long', year: 'numeric' })

const wordCount = (post.body ?? [])
  .filter((block: any) => block._type === 'block')
  .flatMap((block: any) => block.children ?? [])
  .map((span: any) => span.text ?? '')
  .join(' ')
  .split(/\s+/)
  .filter(Boolean).length
const readingMinutes = Math.max(1, Math.round(wordCount / 200))

const video = post.videoUrl ? await resolveVideoEmbed(post.videoUrl) : null

const postUrl = new URL(`/blog/${slug}`, Astro.site).toString()
const shareLinks = [
  { label: 'WhatsApp', href: `https://wa.me/?text=${encodeURIComponent(`${post.title} ${postUrl}`)}` },
  { label: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(postUrl)}` },
  { label: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(postUrl)}` },
  { label: 'X', href: `https://twitter.com/intent/tweet?text=${encodeURIComponent(post.title)}&url=${encodeURIComponent(postUrl)}` },
]
---

<Layout
  title={`${post.title} | Alo Studio Blog`}
  description={post.excerpt ?? ''}
  path={`/blog/${slug}`}
>
  <article class="pt-32 pb-28 px-6">
    <div class="max-w-2xl mx-auto">
      <a href="/blog" class="inline-flex items-center gap-1.5 text-sm font-semibold mb-8 transition-colors duration-200" style={{ color: '#7BAAF7', fontFamily: 'Plus Jakarta Sans, sans-serif' }}>
        ← Volver al blog
      </a>

      <div class="text-white/40 text-sm mb-4" style={{ fontFamily: 'Inter, sans-serif' }}>
        {dateFormatter.format(new Date(post.publishedAt))} · {readingMinutes} min de lectura
      </div>

      <h1 class="heading font-extrabold leading-tight mb-4" style={{ fontSize: 'clamp(1.9rem, 4vw, 2.8rem)', letterSpacing: '-0.02em' }}>
        {post.title}
      </h1>

      {post.tags && post.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-8">
          {post.tags.map((tag: string) => (
            <span class="text-xs font-semibold px-3 py-1 rounded-full" style={{ background: 'rgba(37,99,235,0.12)', color: '#7BAAF7', fontFamily: 'Inter, sans-serif' }}>
              {tag}
            </span>
          ))}
        </div>
      )}

      {post.coverImage && (
        <img
          src={urlFor(post.coverImage).width(1200).height(675).fit('crop').auto('format').url()}
          alt={post.title}
          class="w-full rounded-2xl mb-12 object-cover"
        />
      )}

      {video && (
        <div class="mb-12 flex justify-center">
          <div
            class="relative w-full overflow-hidden rounded-2xl"
            style={{ maxWidth: video.isVertical ? '380px' : '100%', aspectRatio: String(video.aspectRatio) }}
          >
            <iframe
              src={video.embedUrl}
              class="absolute inset-0 w-full h-full"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
        </div>
      )}

      {post.audioFile?.asset?.url && (
        <audio controls class="w-full mb-12" src={post.audioFile.asset.url}>
          Tu navegador no soporta audio HTML5.
        </audio>
      )}

      <div
        class="text-white/80 leading-relaxed [&>p]:mb-6 [&>h2]:heading [&>h2]:font-bold [&>h2]:text-white [&>h2]:mt-12 [&>h2]:mb-4 [&>h3]:heading [&>h3]:font-bold [&>h3]:text-white [&>h3]:mt-10 [&>h3]:mb-3 [&_a]:underline [&_a]:decoration-[#7BAAF7] [&_strong]:text-white [&>ul]:mb-6 [&>ul]:list-disc [&>ul]:pl-6 [&>ol]:mb-6 [&>ol]:list-decimal [&>ol]:pl-6 [&_li]:mb-1.5 [&_blockquote]:border-l-2 [&_blockquote]:pl-5 [&_blockquote]:italic [&_blockquote]:text-white/60"
        style={{ fontFamily: 'Inter, sans-serif', fontSize: '1.15rem' }}
      >
        <PortableText value={post.body} components={{ type: { image: PortableTextImage } }} />
      </div>

      <div class="flex items-center gap-3 mt-16 pt-8" style={{ borderTop: '1px solid rgba(255,255,255,0.08)' }}>
        <span class="text-sm text-white/40" style={{ fontFamily: 'Inter, sans-serif' }}>Compartir:</span>
        {shareLinks.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noreferrer noopener"
            class="text-sm font-semibold px-3 py-1.5 rounded-lg transition-colors duration-200"
            style={{ background: 'rgba(255,255,255,0.05)', border: '1px solid rgba(255,255,255,0.08)', color: 'rgba(255,255,255,0.7)', fontFamily: 'Plus Jakarta Sans, sans-serif' }}
          >
            {s.label}
          </a>
        ))}
      </div>
    </div>
  </article>
</Layout>
